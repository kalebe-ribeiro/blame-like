{
  "name": "cybercosmic",
  "version": "0.1.0",
  "description": "Simulador contemplativo 3D — horror cósmico filtrado por cyberpunk. Electron + Three.js.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "electron . --check",
    "check:pilgrimage": "electron . --check --game=pilgrimage",
    "check:pad": "electron . --check=pad && electron . --check=pad --game=pilgrimage",
    "check:beings": "electron . --check=beings",
    "check:safeguards": "electron . --check=safeguards --game=pilgrimage",
    "check:npcs": "electron . --check=npcs --game=pilgrimage",
    "check:moves": "electron . --check=moves --game=pilgrimage",
    "typecheck": "tsc -p tsconfig.json",
    "profile": "electron . --check=profile --game=pilgrimage",
    "check:climb": "electron . --check=climb --game=pilgrimage"
  },
  "dependencies": {
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^33.0.0",
    "typescript": "^5.9.3"
  }
}
